# Public variables are baked into the build; rebuild after changing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_URL=https://demo.sympos.site/
NEXT_PUBLIC_GITHUB_URL=https://github.com/macmann/RestaurantPOS
NEXT_PUBLIC_COMPANY_NAME=SYM POS
# Optional Plausible analytics domain. No tracker without a value.
NEXT_PUBLIC_ANALYTICS_ID=
# Server-only contact configuration. HTTPS webhook must accept JSON.
CONTACT_EMAIL=
CONTACT_WEBHOOK_URL=
